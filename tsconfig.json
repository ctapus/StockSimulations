{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "strictNullChecks": false, // TODO: enable strict null checks

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": false, // TODO: change to true
    "noUnusedParameters": false, // TODO: change to true
    "erasableSyntaxOnly": false, // TODO: change to true
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
